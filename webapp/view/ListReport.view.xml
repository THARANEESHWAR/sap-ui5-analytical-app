<?xml version="1.0" encoding="UTF-8"?>
<mvc:View
    controllerName="com.tharaneeshwar.analyticalapp.controller.ListReport"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true">
    <Page id="listReportPage" title="{i18n>pageTitle}">
        <headerContent>
            <Button
                icon="sap-icon://refresh"
                press="onRefresh"
                tooltip="{i18n>btnRefresh}" />
            <Button
                icon="sap-icon://chart-bar"
                press="onNavigateToAnalytics"
                tooltip="{i18n>btnAnalytics}" />
        </headerContent>
        <content>
            <VBox class="sapUiSmallMargin">
                <!-- KPI Section -->
                <HBox
                    fitContainer="true"
                    class="sapUiSmallMarginBottom"
                    justifyContent="SpaceAround">
                    <VBox class="kpiBox">
                        <Text text="{i18n>kpiTotalSales}" class="kpiLabel" />
                        <Text text="{/kpiTotalSales}" class="kpiValue" />
                        <Text text="{/kpiTotalSalesTrend}" class="kpiTrend positive" />
                    </VBox>
                    <VBox class="kpiBox">
                        <Text text="{i18n>kpiTotalOrders}" class="kpiLabel" />
                        <Text text="{/kpiTotalOrders}" class="kpiValue" />
                        <Text text="{/kpiTotalOrdersTrend}" class="kpiTrend positive" />
                    </VBox>
                    <VBox class="kpiBox">
                        <Text text="{i18n>kpiAvgOrderValue}" class="kpiLabel" />
                        <Text text="{/kpiAvgOrderValue}" class="kpiValue" />
                        <Text text="{/kpiAvgOrderValueTrend}" class="kpiTrend positive" />
                    </VBox>
                    <VBox class="kpiBox">
                        <Text text="{i18n>kpiCustomerCount}" class="kpiLabel" />
                        <Text text="{/kpiCustomerCount}" class="kpiValue" />
                        <Text text="{/kpiCustomerCountTrend}" class="kpiTrend positive" />
                    </VBox>
                </HBox>

                <!-- Filters Section -->
                <Panel headerText="{i18n>filters}" expandable="true" expanded="true">
                    <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                        <f:content>
                            <Label text="{i18n>labelRegion}" />
                            <MultiComboBox
                                selectedKeys="{/selectedRegions}"
                                selectionChange="onFilterChange">
                                <core:ListItem key="North" text="North" />
                                <core:ListItem key="South" text="South" />
                                <core:ListItem key="East" text="East" />
                                <core:ListItem key="West" text="West" />
                                <core:ListItem key="Central" text="Central" />
                            </MultiComboBox>
                            <Label text="{i18n>labelProduct}" />
                            <MultiComboBox
                                selectedKeys="{/selectedProducts}"
                                selectionChange="onFilterChange">
                                <core:ListItem key="Product A" text="Product A" />
                                <core:ListItem key="Product B" text="Product B" />
                                <core:ListItem key="Product C" text="Product C" />
                                <core:ListItem key="Product D" text="Product D" />
                                <core:ListItem key="Product E" text="Product E" />
                                <core:ListItem key="Product F" text="Product F" />
                            </MultiComboBox>
                            <Label text="{i18n>labelSearchField}" />
                            <SearchField
                                width="100%"
                                search="onSearch"
                                liveChange="onSearch"
                                placeholder="{i18n>searchPlaceholder}" />
                        </f:content>
                    </f:SimpleForm>
                </Panel>

                <!-- Data Table Section -->
                <Table
                    id="salesTable"
                    items="{path: '/sales', templateShareable: false}"
                    class="sapUiSmallMarginTop"
                    mode="MultiSelect"
                    enableBusyIndicator="true">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>salesData}" />
                            <ToolbarSpacer />
                            <Text text="{= ${/sales}.length + ' records'}" class="sapUiSmallMarginEnd" />
                            <Button
                                icon="sap-icon://download"
                                press="onExport"
                                tooltip="{i18n>btnExport}" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>colDate}" />
                        </Column>
                        <Column>
                            <Text text="{i18n>colRegion}" />
                        </Column>
                        <Column>
                            <Text text="{i18n>colProduct}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>colCategory}" />
                        </Column>
                        <Column hAlign="End">
                            <Text text="{i18n>colQuantity}" />
                        </Column>
                        <Column hAlign="End">
                            <Text text="{i18n>colAmount}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>colSalesRep}" />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true">
                            <Text text="{i18n>colCustomer}" />
                        </Column>
                        <Column>
                            <Text text="{i18n>status}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem press="onItemPress" type="Navigation">
                            <cells>
                                <Text text="{date}" />
                                <Text text="{region}" />
                                <Text text="{product}" />
                                <Text text="{category}" />
                                <Text text="{quantity}" />
                                <Text text="{
                                    parts: [{path: 'amount'}],
                                    formatter: '.formatter.formatAmount'
                                }" />
                                <Text text="{salesRep}" />
                                <Text text="{customer}" />
                                <ObjectStatus
                                    state="{statusState}"
                                    text="{status}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>

